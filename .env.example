# ─────────────────────────────────────────────────────────────────
# Student Pass/Fail Prediction System — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars

# MySQL (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_prediction_db
DB_USER=root
DB_PASSWORD=

# Admin credentials (used for seeding initial admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@prediction.com
ADMIN_PASSWORD=Admin@1234

# ML Config
MODEL_DIR=ml/saved_models
LOG_LEVEL=DEBUG
LOG_DIR=logs

# Email (optional — alerts log to file if not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
ADMIN_EMAIL=admin@college.edu
APP_URL=http://localhost:5000
